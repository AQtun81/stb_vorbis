<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AQtun.stb.vorbis</PackageId>
    <PackageProjectUrl>https://github.com/AQtun81/stb_vorbis</PackageProjectUrl>
    <Authors>AQtun</Authors>
    <PackageTags>vorbis ogg audio sound stbvorbis stb_vorbis</PackageTags>
    <Version>1.22.0</Version>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/nothings/stb</RepositoryUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <TargetFrameworks>net10.0;net8.0;net7.0;net5.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="static/**/*" Pack="true" PackagePath="static/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../README.md" Pack="true" PackagePath="/"/>
    <None Include="AQtun.stb.vorbis.targets" Pack="true" PackagePath="buildTransitive/AQtun.stb.vorbis.targets"/>
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

</Project>
